---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  article?: SEOProps['article'];
  breadcrumbs?: SEOProps['breadcrumbs'];
}

const {
  title,
  description,
  image,
  canonicalURL,
  article,
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0284c7" />

    <!-- Otimizações de Conexão para Core Web Vitals -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- SEO Component (Metatags, OpenGraph, Twitter, Schema.org) -->
    <SEO
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      article={article}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col antialiased selection:bg-[#dd3333] selection:text-white font-sans">
    <Header />
    <main class="flex-1 w-full bg-white">
      <slot />
    </main>
    <Footer />
  </body>
</html>
