---
export interface Props {
  slotType: 'header' | 'in-article' | 'sidebar' | 'footer';
  customClass?: string;
  adId?: string;
}

const { slotType, customClass = '', adId } = Astro.props;

// Definição das alturas mínimas obrigatórias para mitigar CLS (Cumulative Layout Shift)
const heightClasses: Record<Props['slotType'], string> = {
  'header': 'min-h-[90px] max-w-[728px] md:min-h-[90px]',
  'in-article': 'min-h-[250px] max-w-[336px] sm:max-w-[728px] md:min-h-[280px]',
  'sidebar': 'min-h-[600px] max-w-[300px]',
  'footer': 'min-h-[90px] max-w-[728px]',
};

// Obtenção da classe de altura correspondente
const minHeightClass = heightClasses[slotType] || 'min-h-[90px]';
---

<aside 
  class={`ad-slot-wrapper w-full my-6 flex flex-col items-center justify-center overflow-hidden transition-opacity ${customClass}`}
  aria-label={`Espaço publicitário ${slotType}`}
>
  <div 
    class={`ad-container relative w-full flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-400 dark:border-neutral-600 bg-gray-100 dark:bg-neutral-900/60 text-neutral-400 dark:text-neutral-500 p-3 ${minHeightClass}`}
    data-slot-type={slotType}
    id={adId ? `ad-${adId}` : undefined}
  >
    <div class="ad-label-wrapper w-full text-right mb-1">
      <span class="text-[10px] uppercase tracking-widest text-gray-400 dark:text-neutral-500 font-bold select-none">
        Publicidade
      </span>
    </div>

    {/* Área modular de renderização de Anúncios (Google AdSense, Afiliados ou Banners) */}
    <div class="ad-content-slot w-full h-full flex flex-1 items-center justify-center text-center">
      <slot>
        {/* Placeholder elegante Bento Grid ativo caso nenhum script/parceiro esteja injetado */}
        <div class="flex flex-col items-center justify-center p-4">
          <svg class="w-6 h-6 mb-1 text-gray-400 dark:text-neutral-500 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
          </svg>
          <span class="text-xs font-mono font-semibold uppercase text-gray-600 dark:text-neutral-300">
            Espaço Reservado ({slotType})
          </span>
          <span class="text-[10px] font-mono text-gray-400 dark:text-neutral-500 mt-0.5">
            Sem impacto em CLS
          </span>
        </div>
      </slot>
    </div>
  </div>
</aside>
