---
import type { NoticiaListItem } from '../types/database.types';

export interface Props {
  noticia: NoticiaListItem;
  variant?: 'featured' | 'standard' | 'compact';
  priority?: boolean;
  class?: string;
}

const { noticia, variant = 'standard', priority = false, class: customClass = '' } = Astro.props;

const safeTitle = (noticia.titulo && noticia.titulo.trim()) || 'Notícia em Atualização';
const safeSummary = (noticia.resumo && noticia.resumo.trim()) || 'Clique para ler a cobertura completa desta matéria.';
const safeSlug = (noticia.slug && noticia.slug.trim().replace(/^\/+|\/+$/g, '')) || (noticia.id ? `noticia-${noticia.id}` : 'recente');

// Formatação amigável de data em português
const dateFormatted = new Date(noticia.created_at || Date.now()).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

// Tempo relativo ou hora
const timeFormatted = new Date(noticia.created_at || Date.now()).toLocaleTimeString('pt-BR', {
  hour: '2-digit',
  minute: '2-digit',
});
---

{variant === 'featured' ? (
  <article class={`group relative flex flex-col h-full bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl overflow-hidden shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all duration-200 ${customClass}`}>
    <a href={`/noticia/${safeSlug}`} class="block relative w-full aspect-[16/10] sm:aspect-[16/9] md:aspect-[21/10] lg:aspect-[16/9] overflow-hidden border-b-2 border-black dark:border-neutral-700 focus:outline-none" aria-label={`Ler matéria: ${safeTitle}`}>
      <img
        src={noticia.imagem}
        alt={safeTitle}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        width="800"
        height="450"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 pointer-events-none"></div>
      <span class="absolute top-4 left-4 bg-blue-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded shadow-xs tracking-wider z-10 pointer-events-none">
        {noticia.categoria}
      </span>
    </a>
    <div class="flex-1 p-5 sm:p-6 md:p-7 flex flex-col justify-between bg-white dark:bg-neutral-900">
      <div>
        <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-neutral-400 mb-2.5">
          <span>{noticia.autor}</span>
          <span>•</span>
          <time datetime={noticia.created_at}>{dateFormatted}</time>
        </div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-black uppercase italic tracking-tight text-neutral-950 dark:text-white group-hover:text-blue-600 transition-colors leading-tight">
          <a href={`/noticia/${safeSlug}`} class="focus:outline-none hover:underline">
            {safeTitle}
          </a>
        </h2>
        <a href={`/noticia/${safeSlug}`} class="block mt-3 text-gray-600 dark:text-neutral-300 line-clamp-2 sm:line-clamp-3 leading-relaxed text-xs sm:text-sm hover:text-neutral-950 dark:hover:text-white transition-colors">
          {safeSummary}
        </a>
      </div>
      <div class="mt-5 pt-3.5 border-t border-gray-200 dark:border-neutral-800 flex items-center justify-between">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Destaque Principal</span>
        <a href={`/noticia/${safeSlug}`} class="flex items-center gap-2 text-xs font-bold uppercase text-black dark:text-white group-hover:text-blue-600 transition-colors focus:outline-none">
          <span>Acessar Matéria</span>
          <div class="w-8 h-8 rounded-full bg-black dark:bg-white text-white dark:text-black flex items-center justify-center text-xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
            →
          </div>
        </a>
      </div>
    </div>
  </article>
) : variant === 'compact' ? (
  <article class={`group relative flex gap-4 items-center p-3 hover:bg-gray-50 dark:hover:bg-neutral-800/50 rounded-lg transition-colors border-b border-gray-200 dark:border-neutral-800 last:border-b-0 ${customClass}`}>
    <a href={`/noticia/${safeSlug}`} class="w-20 h-20 sm:w-24 sm:h-20 shrink-0 rounded-lg overflow-hidden relative border border-black dark:border-neutral-700 block focus:outline-none" aria-label={`Ler notícia: ${safeTitle}`}>
      <img
        src={noticia.imagem}
        alt={safeTitle}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        width="96"
        height="80"
      />
    </a>
    <div class="flex-1 min-w-0">
      <span class="text-[10px] font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest block mb-1">
        {noticia.categoria}
      </span>
      <h3 class="text-sm font-bold uppercase leading-snug text-neutral-950 dark:text-white line-clamp-2 group-hover:text-blue-600 transition-colors">
        <a href={`/noticia/${safeSlug}`} class="hover:underline focus:outline-none">
          {safeTitle}
        </a>
      </h3>
      <div class="flex items-center justify-between mt-2 text-[10px] font-bold text-gray-400">
        <time datetime={noticia.created_at}>{dateFormatted}</time>
        <a href={`/noticia/${safeSlug}`} class="w-6 h-6 rounded-full bg-black dark:bg-neutral-700 text-white flex items-center justify-center text-[10px] group-hover:bg-blue-600 transition-colors focus:outline-none" aria-label="Abrir">
          →
        </a>
      </div>
    </div>
  </article>
) : (
  <article class={`group relative flex flex-col justify-between h-full bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl overflow-hidden shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all duration-200 ${customClass}`}>
    {noticia.imagem && (
      <a href={`/noticia/${safeSlug}`} class="block relative w-full aspect-[16/9] overflow-hidden border-b-2 border-black dark:border-neutral-700 focus:outline-none" aria-label={`Ler notícia: ${safeTitle}`}>
        <img
          src={noticia.imagem}
          alt={safeTitle}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
          width="500"
          height="281"
        />
        <span class="absolute top-3 left-3 bg-blue-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded shadow-xs tracking-wider z-10 pointer-events-none">
          {noticia.categoria}
        </span>
      </a>
    )}
    <div class="p-5 flex-1 flex flex-col justify-between">
      <div>
        <div class="text-blue-600 dark:text-blue-400 text-[10px] font-black uppercase tracking-wider mb-2">
          {noticia.categoria}
        </div>
        <h3 class="text-base sm:text-lg font-bold uppercase leading-tight text-neutral-950 dark:text-white group-hover:text-blue-600 transition-colors line-clamp-2">
          <a href={`/noticia/${safeSlug}`} class="hover:underline focus:outline-none">
            {safeTitle}
          </a>
        </h3>
        <a href={`/noticia/${safeSlug}`} class="block mt-2 text-xs sm:text-sm text-gray-600 dark:text-neutral-300 line-clamp-2 leading-relaxed hover:text-neutral-950 dark:hover:text-white transition-colors">
          {safeSummary}
        </a>
      </div>
      <div class="flex justify-between items-end mt-5 pt-3 border-t border-gray-100 dark:border-neutral-800">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">
          {dateFormatted}
        </span>
        <a href={`/noticia/${safeSlug}`} class="w-8 h-8 rounded-full bg-black dark:bg-white text-white dark:text-black flex items-center justify-center text-xs group-hover:bg-blue-600 group-hover:text-white transition-colors focus:outline-none" aria-label="Abrir matéria">
          →
        </a>
      </div>
    </div>
  </article>
)}
