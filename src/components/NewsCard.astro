---
import type { NoticiaListItem } from '../types/database.types';
import { getCategoryStyle } from '../lib/categories';

export interface Props {
  noticia: NoticiaListItem;
  variant?: 'featured' | 'standard' | 'compact' | 'lateral' | 'ranked';
  priority?: boolean;
  class?: string;
  rank?: number;
}

const { noticia, variant = 'standard', priority = false, class: customClass = '', rank } = Astro.props;

const rawTitle = noticia.titulo ? noticia.titulo.trim() : '';
const isTitleCorrupt = !rawTitle || rawTitle === '{' || rawTitle === '{}' || rawTitle.length < 3;
const safeTitle = !isTitleCorrupt 
  ? rawTitle 
  : (noticia.resumo && noticia.resumo.trim().length > 5 ? noticia.resumo.trim().slice(0, 90) : 'Notícia em Atualização');
const safeSummary = (noticia.resumo && noticia.resumo.trim()) || 'Clique para conferir a cobertura completa desta matéria.';
const safeSlug = (noticia.slug && noticia.slug.trim().replace(/^\/+|\/+$/g, '')) || (noticia.id ? `noticia-${noticia.id}` : 'recente');
const DEFAULT_IMAGE = 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?q=80&w=1200&auto=format&fit=crop';
const safeImage = (noticia.imagem && noticia.imagem.trim()) || DEFAULT_IMAGE;

// Formatação amigável de data em português
const dateFormatted = new Date(noticia.created_at || Date.now()).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

// Categoria normalizada e estilo temático específico
const catStyle = getCategoryStyle(noticia.categoria, noticia.titulo);
---

{/* =========================================================================
    1. VARIANTE FEATURED: SUPER DESTAQUE CINEMATOGRÁFICO (Estilo CPG)
    Capa ampla com gradiente escuro na base, badge pílula arredondada e título forte
========================================================================= */}
{variant === 'featured' ? (
  <article class={`group relative w-full min-h-[380px] sm:min-h-[440px] lg:min-h-[500px] rounded-2xl overflow-hidden bg-neutral-900 border border-neutral-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-end ${customClass}`}>
    <a href={`/noticia/${safeSlug}`} class="block absolute inset-0 focus:outline-none" aria-label={`Ler matéria: ${safeTitle}`}>
      <img
        src={safeImage}
        alt={safeTitle}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
        width="1000"
        height="600"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent pointer-events-none"></div>
    </a>

    <div class="relative z-10 p-4 sm:p-7 md:p-8 flex flex-col justify-end pointer-events-auto">
      <div class="pointer-events-auto">
        <div class="flex items-center gap-2 mb-2 sm:mb-3 flex-wrap">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#dd3333] text-white text-[10px] sm:text-xs font-bold uppercase tracking-wider px-3 py-1 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
            PLANTÃO
          </span>
          <a 
            href={`/categoria/${catStyle.slug}`}
            class={`inline-block rounded-full ${catStyle.bg} ${catStyle.hoverBg} text-white text-[10px] sm:text-xs font-bold uppercase tracking-wider px-3 py-1 transition-colors shadow-sm backdrop-blur-xs border border-white/20`}
          >
            {catStyle.name}
          </a>
        </div>

        <h2 class="text-lg sm:text-2xl lg:text-3xl font-bold leading-[125%] text-white tracking-tight group-hover:underline">
          <a href={`/noticia/${safeSlug}`} class="focus:outline-none">
            {safeTitle}
          </a>
        </h2>

        {safeSummary && (
          <p class="text-neutral-200 text-xs sm:text-sm line-clamp-2 sm:line-clamp-3 mt-1.5 sm:mt-2 leading-relaxed">
            {safeSummary}
          </p>
        )}

        <div class="mt-2.5 sm:mt-3 flex items-center justify-between gap-3 text-xs text-neutral-300 font-medium flex-wrap">
          <div class="flex items-center gap-2">
            <span>Por <strong class="text-white font-semibold">{noticia.autor || 'Redação'}</strong></span>
            <span>•</span>
            <time datetime={noticia.created_at}>{dateFormatted}</time>
          </div>
          <span class="text-white group-hover:text-neutral-200 font-bold transition-colors flex items-center gap-1">
            Ler completa →
          </span>
        </div>
      </div>
    </div>
  </article>
) : variant === 'lateral' ? (
  /* =========================================================================
     2. VARIANTE LATERAL: GRID LATERAL 2x2 DE DESTAQUES (Estilo CPG na cor branca)
     Cards com thumbnail arredondada, categoria em cor temática dinâmica, fundo branco
  ========================================================================= */
  <article class={`group flex flex-col justify-between h-full bg-white rounded-xl p-3 border border-neutral-200 hover:border-neutral-300 hover:shadow-xs transition-all ${customClass}`}>
    <div class="space-y-2.5">
      <a href={`/noticia/${safeSlug}`} class="block aspect-[16/10] overflow-hidden rounded-xl bg-neutral-100 relative focus:outline-none" aria-label={`Ler matéria: ${safeTitle}`}>
        <img
          src={safeImage}
          alt={safeTitle}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 rounded-xl"
          width="400"
          height="250"
        />
        <span class={`absolute top-2 left-2 rounded-full ${catStyle.bg} text-white text-[10px] font-bold uppercase px-2.5 py-0.5 tracking-wider shadow-xs z-10 pointer-events-none`}>
          {catStyle.name}
        </span>
      </a>

      <div>
        <a href={`/categoria/${catStyle.slug}`} class={`text-[10px] font-bold ${catStyle.text} ${catStyle.hoverText} uppercase tracking-wider inline-block mb-1`}>
          {catStyle.name}
        </a>
        <h3 class={`text-sm sm:text-base font-bold text-neutral-900 line-clamp-3 leading-snug ${catStyle.hoverText} transition-colors`}>
          <a href={`/noticia/${safeSlug}`} class="focus:outline-none">
            {safeTitle}
          </a>
        </h3>
      </div>
    </div>

    <div class="pt-2 mt-2 border-t border-neutral-100 flex items-center justify-between text-[11px] text-neutral-500 font-medium">
      <span class="truncate max-w-[120px]">{noticia.autor || 'Redação'}</span>
      <time datetime={noticia.created_at}>{dateFormatted}</time>
    </div>
  </article>
) : variant === 'ranked' ? (
  /* =========================================================================
     3. VARIANTE RANKED: LISTA DAS MAIS LIDAS NUMERADAS 1 A 5 (Estilo CPG na cor branca)
  ========================================================================= */
  <article class={`group flex items-center gap-3.5 py-3 border-b border-neutral-100 last:border-b-0 hover:bg-neutral-50 p-2 rounded-xl transition-colors ${customClass}`}>
    {rank !== undefined && (
      <span class="text-2xl sm:text-3xl font-black text-neutral-300 group-hover:text-neutral-700 transition-colors shrink-0 w-7 text-center font-mono">
        {rank}
      </span>
    )}
    <a href={`/noticia/${safeSlug}`} class="w-18 h-18 sm:w-20 sm:h-20 shrink-0 rounded-xl overflow-hidden relative block focus:outline-none bg-neutral-100" aria-label={`Ler notícia: ${safeTitle}`}>
      <img
        src={safeImage}
        alt={safeTitle}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 rounded-xl"
        width="80"
        height="80"
      />
    </a>
    <div class="flex-1 min-w-0">
      <a href={`/categoria/${catStyle.slug}`} class={`text-[10px] font-bold ${catStyle.text} ${catStyle.hoverText} uppercase tracking-wider inline-block mb-0.5`}>
        {catStyle.name}
      </a>
      <h4 class={`text-xs sm:text-sm font-bold text-neutral-900 line-clamp-2 leading-snug ${catStyle.hoverText} transition-colors`}>
        <a href={`/noticia/${safeSlug}`} class="focus:outline-none">
          {safeTitle}
        </a>
      </h4>
      <div class="flex items-center gap-2 text-[10px] text-neutral-400 mt-1">
        <time datetime={noticia.created_at}>{dateFormatted}</time>
      </div>
    </div>
  </article>
) : variant === 'compact' ? (
  /* =========================================================================
     4. VARIANTE COMPACT: FEED HORIZONTAL COM THUMBNAIL ARREDONDADA (Fundo Branco)
  ========================================================================= */
  <article class={`group flex flex-col sm:flex-row gap-3.5 sm:items-center p-3.5 bg-white rounded-xl border border-neutral-200 hover:border-neutral-300 hover:shadow-xs transition-all ${customClass}`}>
    <a href={`/noticia/${safeSlug}`} class="w-full sm:w-44 sm:h-28 h-40 shrink-0 rounded-xl overflow-hidden relative block focus:outline-none bg-neutral-100" aria-label={`Ler notícia: ${safeTitle}`}>
      <img
        src={safeImage}
        alt={safeTitle}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 rounded-xl"
        width="176"
        height="112"
      />
      <span class={`absolute top-2 left-2 rounded-full ${catStyle.bg} text-white text-[10px] font-bold uppercase px-2.5 py-0.5 tracking-wider sm:hidden shadow-xs z-10 pointer-events-none`}>
        {catStyle.name}
      </span>
    </a>
    <div class="flex-1 min-w-0 flex flex-col justify-between">
      <div>
        <div class="hidden sm:flex items-center gap-2 mb-1.5">
          <a href={`/categoria/${catStyle.slug}`} class={`text-xs font-bold ${catStyle.text} ${catStyle.hoverText} uppercase tracking-wide`}>
            {catStyle.name}
          </a>
          <span class="text-neutral-300">•</span>
          <span class="text-[11px] text-neutral-500 font-medium">
            {noticia.autor || 'Redação'}
          </span>
        </div>
        <h3 class={`text-base sm:text-lg font-bold text-neutral-900 line-clamp-2 leading-snug ${catStyle.hoverText} transition-colors`}>
          <a href={`/noticia/${safeSlug}`} class="focus:outline-none">
            {safeTitle}
          </a>
        </h3>
        {safeSummary && (
          <p class="text-xs text-neutral-600 line-clamp-2 mt-1 leading-relaxed">
            {safeSummary}
          </p>
        )}
      </div>
      <div class="flex items-center justify-between mt-2 pt-2 border-t border-neutral-100 text-[11px] text-neutral-500">
        <time datetime={noticia.created_at}>{dateFormatted}</time>
        <span class={`font-bold ${catStyle.text} group-hover:translate-x-1 transition-transform flex items-center gap-1 text-xs`}>
          Ler matéria <span>→</span>
        </span>
      </div>
    </div>
  </article>
) : (
  /* =========================================================================
     5. VARIANTE STANDARD: CARD EDITORIAL EM GRADE (Fundo Branco)
  ========================================================================= */
  <article class={`group flex flex-col justify-between h-full bg-white rounded-xl border border-neutral-200 overflow-hidden hover:border-neutral-300 hover:shadow-xs transition-all ${customClass}`}>
    <div>
      <a href={`/noticia/${safeSlug}`} class="block relative w-full aspect-[16/9] overflow-hidden focus:outline-none bg-neutral-100" aria-label={`Ler notícia: ${safeTitle}`}>
        <img
          src={safeImage}
          alt={safeTitle}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
          width="500"
          height="281"
        />
        <span class={`absolute top-3 left-3 ${catStyle.bg} text-white text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full tracking-wider z-10 pointer-events-none shadow-xs`}>
          {catStyle.name}
        </span>
      </a>
      <div class="p-4 sm:p-5">
        <a href={`/categoria/${catStyle.slug}`} class={`${catStyle.text} ${catStyle.hoverText} text-xs font-bold uppercase tracking-wide mb-1.5 inline-block`}>
          {catStyle.name}
        </a>
        <h3 class={`text-base sm:text-lg font-bold leading-snug text-neutral-900 ${catStyle.hoverText} transition-colors line-clamp-2`}>
          <a href={`/noticia/${safeSlug}`} class="focus:outline-none">
            {safeTitle}
          </a>
        </h3>
        {safeSummary && (
          <p class="mt-2 text-xs sm:text-sm text-neutral-600 line-clamp-2 leading-relaxed">
            {safeSummary}
          </p>
        )}
      </div>
    </div>
    <div class="px-4 sm:px-5 pb-4 pt-3 border-t border-neutral-100 flex justify-between items-center text-[11px] text-neutral-500">
      <span>{noticia.autor || 'Redação'} • {dateFormatted}</span>
      <a href={`/noticia/${safeSlug}`} class={`w-7 h-7 rounded-full bg-neutral-100 text-neutral-700 ${catStyle.hoverBg} hover:text-white flex items-center justify-center text-xs transition-colors focus:outline-none`} aria-label="Abrir matéria">
        →
      </a>
    </div>
  </article>
)}
