---
import AdBanner from './AdBanner.astro';
import { OFFICIAL_CATEGORIES } from '../lib/categories';

const navCategories = [
  { name: 'Início', href: '/', slug: '' },
  ...OFFICIAL_CATEGORIES.map((cat) => ({
    name: cat.name,
    href: `/categoria/${cat.slug}`,
    slug: cat.slug,
  })),
];

const trendingTags = [
  { name: 'Maceió Hoje', href: '/categoria/maceio' },
  { name: 'Segurança & Polícia', href: '/categoria/policia' },
  { name: 'Esportes', href: '/categoria/esporte' },
  { name: 'Negócios & Mercado', href: '/categoria/economia' },
];

const currentDate = new Date().toLocaleDateString('pt-BR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="w-full bg-white border-b border-neutral-200 shadow-xs">
  {/* Topbar Informativa com data e links */}
  <div class="border-b border-slate-800 text-[11px] text-slate-300 py-1.5 px-4 sm:px-8 bg-[#090D16]">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-2 capitalize font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-white">{currentDate}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="hover:text-white transition-colors flex items-center gap-1 font-semibold text-slate-300" target="_blank" rel="noopener noreferrer">
          <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" width="14" height="14" style="width: 14px; height: 14px; max-width: 14px; max-height: 14px;" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS FEED
        </a>
        <a href="/sitemap.xml" class="hover:text-white transition-colors font-semibold text-slate-300" target="_blank" rel="noopener noreferrer">SITEMAP</a>
        <span class="text-slate-600">|</span>
        <span class="font-mono text-[10px] uppercase text-slate-400">SSR EDGE VERCEL</span>
      </div>
    </div>
  </div>

  {/* Barra Principal da Marca (Cabeçalho em #0F172A) */}
  <div class="w-full bg-[#0F172A] text-white shadow-xs border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a href="/" class="group flex items-center gap-2">
          <div class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tighter uppercase italic text-white drop-shadow-xs">
            PORTAL<span class="text-[#dd3333]">NOTÍCIAS</span>
          </div>
        </a>
        <span class="hidden sm:inline-block text-[10px] font-bold text-slate-400 uppercase tracking-widest pl-3 border-l border-slate-700">
          Jornalismo em Tempo Real
        </span>
      </div>

      {/* Ações e Status */}
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a 
          href="/admin" 
          class="text-xs font-mono font-bold bg-white text-[#0F172A] hover:bg-slate-100 border border-transparent px-4 py-1.5 rounded-full transition-all flex items-center gap-2 shadow-xs"
          title="Acessar Painel de Redação e Gerenciamento"
        >
          <span class="w-2 h-2 rounded-full bg-[#0F172A]"></span>
          <span>PAINEL ADMIN</span>
        </a>

        <div class="hidden sm:flex text-xs font-mono font-bold bg-slate-800/90 text-slate-200 border border-slate-700 px-3.5 py-1.5 rounded-full tracking-tight items-center gap-2 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>LIVE: SSR OK</span>
        </div>
      </div>
    </div>
  </div>

  {/* =========================================================================
      BARRA DE MENU SUPERIOR (FUNDO BRANCO LIMPO, SEM A COR AZUL NO CONTAINER)
  ========================================================================= */}
  <div class="sticky top-0 z-40 bg-white text-neutral-800 border-b border-neutral-200 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-2.5 flex items-center justify-between gap-4">
      
      {/* Menu Superior Desktop */}
      <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 overflow-x-auto scrollbar-none py-0.5" aria-label="Menu Superior de Categorias">
        {navCategories.map((cat) => {
          const active = isCurrent(cat.href);
          return (
            <a
              href={cat.href}
              class={`px-3 xl:px-3.5 py-1.5 rounded-full text-[11px] xl:text-xs font-bold uppercase tracking-wider shrink-0 transition-all duration-150 ${
                active
                  ? 'bg-[#0F172A] text-white shadow-xs'
                  : 'text-neutral-700 hover:text-[#0F172A] hover:bg-neutral-100 font-bold'
              }`}
            >
              {cat.name}
            </a>
          );
        })}
      </nav>

      {/* Tags Rápidas em Destaque no Menu Superior */}
      <div class="hidden xl:flex items-center gap-2 text-xs font-medium">
        <span class="text-[10px] font-mono font-bold text-[#0F172A] uppercase">Tópicos:</span>
        {trendingTags.map((tag) => (
          <a
            href={tag.href}
            class="px-2.5 py-1 rounded-full bg-neutral-100 hover:bg-slate-100 text-neutral-600 hover:text-[#0F172A] border border-neutral-200 hover:border-slate-300 text-[11px] font-semibold transition-all"
          >
            #{tag.name}
          </a>
        ))}
      </div>

      {/* Menu Mobile Horizontal Scrollable */}
      <div class="lg:hidden w-full overflow-x-auto scrollbar-none py-0.5">
        <nav class="flex items-center gap-2 whitespace-nowrap" aria-label="Menu Superior Mobile">
          {navCategories.map((cat) => {
            const active = isCurrent(cat.href);
            return (
              <a
                href={cat.href}
                class={`px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shrink-0 transition-all ${
                  active
                    ? 'bg-[#0F172A] text-white shadow-xs'
                    : 'text-neutral-700 hover:text-[#0F172A] hover:bg-neutral-100'
                }`}
              >
                {cat.name}
              </a>
            );
          })}
        </nav>
      </div>

    </div>
  </div>

  {/* Banner Publicitário Dedicado abaixo do cabeçalho e menu (min-h-[90px] para mitigar CLS) */}
  <div class="w-full bg-white border-b border-neutral-100 flex items-center justify-center min-h-[90px] px-4 py-2">
    <div class="w-full max-w-[728px]">
      <AdBanner slotType="header" customClass="!my-0" />
    </div>
  </div>
</header>

