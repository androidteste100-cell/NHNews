---
import AdBanner from './AdBanner.astro';

const navCategories = [
  { name: 'Início', href: '/' },
  { name: 'Tecnologia', href: '/categoria/Tecnologia' },
  { name: 'Economia', href: '/categoria/Economia' },
  { name: 'Mercados', href: '/categoria/Mercados' },
  { name: 'Ciência', href: '/categoria/Ciência' },
  { name: 'Cidades', href: '/categoria/Cidades' },
  { name: 'Segurança', href: '/categoria/Segurança' },
];

const currentDate = new Date().toLocaleDateString('pt-BR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<header class="w-full bg-white dark:bg-neutral-900 border-b-2 border-black dark:border-neutral-700">
  {/* Top Banner Publicitário Dedicado (min-h-[90px] para mitigar CLS) */}
  <div class="w-full bg-white dark:bg-neutral-900 border-b border-gray-300 dark:border-neutral-800 flex items-center justify-center min-h-[90px] px-4 py-2">
    <div class="w-full max-w-[728px]">
      <AdBanner slotType="header" customClass="!my-0" />
    </div>
  </div>

  {/* Topbar Informativa com data e links */}
  <div class="border-b border-gray-200 dark:border-neutral-800 text-[11px] text-gray-500 py-1 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-2 capitalize">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-medium">{currentDate}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="hover:text-blue-600 transition-colors flex items-center gap-1 font-medium" target="_blank" rel="noopener noreferrer">
          <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" width="14" height="14" style="width: 14px; height: 14px; max-width: 14px; max-height: 14px;" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS FEED
        </a>
        <a href="/sitemap.xml" class="hover:text-blue-600 transition-colors font-medium" target="_blank" rel="noopener noreferrer">SITEMAP</a>
        <span class="text-gray-300 dark:text-neutral-700">|</span>
        <span class="font-mono text-[10px] uppercase text-gray-400">SSR EDGE VERCEL</span>
      </div>
    </div>
  </div>

  {/* Barra Principal da Marca e Navegação Bento Grid */}
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-2">
        <div class="text-2xl sm:text-3xl font-black tracking-tighter uppercase italic text-black dark:text-white">
          PORTAL<span class="text-blue-600">NOTÍCIAS</span>
        </div>
      </a>

      {/* Navegação Desktop Bento */}
      <nav class="hidden md:flex items-center gap-5 text-xs font-bold uppercase tracking-widest text-gray-500">
        <a href="/" class="text-black dark:text-white border-b-2 border-blue-600 pb-0.5">Início</a>
        <a href="/categoria/Tecnologia" class="hover:text-blue-600 transition-colors pb-0.5">Tecnologia</a>
        <a href="/categoria/Economia" class="hover:text-blue-600 transition-colors pb-0.5">Economia</a>
        <a href="/categoria/Mercados" class="hover:text-blue-600 transition-colors pb-0.5">Mercados</a>
        <a href="/categoria/Ciência" class="hover:text-blue-600 transition-colors pb-0.5">Ciência</a>
        <a href="/categoria/Cidades" class="hover:text-blue-600 transition-colors pb-0.5">Cidades</a>
        <a href="/categoria/Segurança" class="hover:text-blue-600 transition-colors pb-0.5">Segurança</a>
      </nav>
    </div>

    {/* Status Badge Estilo Bento Grid */}
    <div class="flex items-center gap-2 sm:gap-3">
      <a 
        href="/admin" 
        class="text-[10px] font-mono font-bold bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 border border-black dark:border-neutral-600 px-2 sm:px-2.5 py-1 rounded hover:bg-neutral-950 hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors flex items-center gap-1.5"
        title="Acessar Painel de Redação e Gerenciamento"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        <span>PAINEL ADMIN</span>
      </a>

      <div class="hidden sm:flex text-[10px] font-mono font-bold bg-black text-white px-2.5 py-1 rounded tracking-tight items-center gap-1.5 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span>LIVE: SSR OK</span>
      </div>
      
      {/* Mobile Toggle */}
      <div class="md:hidden">
        <a href="#menu-nav" class="p-1.5 text-black dark:text-white rounded border border-black dark:border-neutral-700 flex items-center justify-center" aria-label="Menu de Navegação">
          <svg class="w-5 h-5 shrink-0" width="20" height="20" style="width: 20px; height: 20px; max-width: 20px; max-height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Menu Mobile Horizontal Scrollable */}
  <nav id="menu-nav" class="md:hidden bg-neutral-900 text-white border-t border-black overflow-x-auto" aria-label="Categorias Mobile">
    <div class="max-w-7xl mx-auto px-4 py-1">
      <ul class="flex items-center space-x-2 text-xs font-bold uppercase tracking-wider whitespace-nowrap scrollbar-none py-1">
        {navCategories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="inline-block px-3 py-1.5 rounded hover:bg-neutral-800 hover:text-blue-400 transition-colors text-neutral-200"
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>
