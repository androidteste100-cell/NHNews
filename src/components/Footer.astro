---
import AdBanner from './AdBanner.astro';

const currentYear = new Date().getFullYear();

const categories = [
  'Tecnologia',
  'Economia',
  'Mercados',
  'Ciência',
  'Cidades',
  'Segurança',
];
---

<footer class="w-full bg-white dark:bg-black text-slate-900 dark:text-neutral-100 border-t-2 border-black mt-16 pt-10 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Banner de Rodapé Bento (min-h-[90px] para CLS) */}
    <div class="mb-10 flex justify-center">
      <div class="w-full max-w-[728px] bg-gray-50 dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl p-2">
        <AdBanner slotType="footer" customClass="!my-0" />
      </div>
    </div>

    {/* Grid de Informações Bento */}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b-2 border-black dark:border-neutral-800">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <div class="text-2xl font-black tracking-tighter uppercase italic text-black dark:text-white">
            PORTAL<span class="text-blue-600">NOTÍCIAS</span>
          </div>
        </div>
        <p class="text-sm text-gray-600 dark:text-neutral-400 max-w-md leading-relaxed">
          Portal de notícias automatizado de última geração com Astro SSR, Supabase e Vercel. 
          Cobertura em tempo real com integridade de dados, otimização para Core Web Vitals e conformidade total com Google News.
        </p>
        <div class="mt-4 font-mono text-[10px] text-gray-400 uppercase">
          PUBLICAÇÃO CONTÍNUA VIA SUPABASE & VERCEL SSR EDGE
        </div>
      </div>

      <div>
        <h3 class="text-xs font-black text-black dark:text-white uppercase tracking-widest mb-4">
          Categorias
        </h3>
        <ul class="space-y-2 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-neutral-400">
          {categories.map((cat) => (
            <li>
              <a href={`/categoria/${cat}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-black text-black dark:text-white uppercase tracking-widest mb-4">
          Transparência & Dados
        </h3>
        <ul class="space-y-2 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-neutral-400">
          <li>
            <a href="/rss.xml" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5" target="_blank" rel="noopener noreferrer">
              <span>Feed RSS (Google News)</span>
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors" target="_blank" rel="noopener noreferrer">
              Mapa do Site (XML)
            </a>
          </li>
          <li>
            <a href="/robots.txt" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors" target="_blank" rel="noopener noreferrer">
              Diretrizes de Rastreio (robots.txt)
            </a>
          </li>
          <li>
            <a href="https://supabase.com" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors" target="_blank" rel="noopener noreferrer">
              Infraestrutura Supabase
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Linha Final de Copyright */}
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500 font-medium">
      <p>© {currentYear} Portal de Notícias. Todos os direitos reservados.</p>
      <div class="flex items-center gap-3 font-mono text-[11px] uppercase">
        <span class="bg-gray-100 dark:bg-neutral-800 px-2 py-0.5 rounded border border-gray-300 dark:border-neutral-700">ASTRO SSR</span>
        <span class="bg-gray-100 dark:bg-neutral-800 px-2 py-0.5 rounded border border-gray-300 dark:border-neutral-700">TAILWIND</span>
        <span class="bg-gray-100 dark:bg-neutral-800 px-2 py-0.5 rounded border border-gray-300 dark:border-neutral-700">SUPABASE</span>
      </div>
    </div>
  </div>
</footer>
