---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getRecentNoticias, isSupabaseConnected, isSupabaseTableMissing } from '../lib/supabase';

// Execução SSR: busca das notícias mais recentes
const noticias = await getRecentNoticias(12);

// Divisão estrutural para a composição Bento Grid
const manchetePrincipal = noticias[0];
const destaqueSecundario = noticias[1];
const noticiasBentoGrid = noticias.slice(2, 5);
const noticiasFeed = noticias.slice(5, 9);
const noticiasMaisLidas = noticias.slice(9, 12);

const hasSupabase = isSupabaseConnected();
const tableMissing = isSupabaseTableMissing();
---

<Layout
  title="Portal de Notícias — Informação em Tempo Real"
  description="Portal de notícias atualizado continuamente com inteligência artificial, cobertura jornalística, economia, mercados, ciência e tecnologia."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    {!hasSupabase && (
      <div class="mb-6 p-4 rounded-xl bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-none">
        <div class="flex items-center gap-2.5">
          <span class={`w-2.5 h-2.5 rounded-full ${tableMissing ? 'bg-amber-500 animate-pulse' : 'bg-blue-600 animate-ping'} shrink-0`}></span>
          <span class="text-neutral-900 dark:text-neutral-100 font-medium">
            {tableMissing ? (
              <>
                <strong>Conexão Supabase Detectada:</strong> A tabela <code>public.noticias</code> ainda não foi criada no seu banco. Execute o script <code>supabase/schema.sql</code> no SQL Editor do painel Supabase para sincronizar suas matérias.
              </>
            ) : (
              <>
                <strong>Modo de Demonstração Ativo:</strong> Exibindo dados de teste. Configure <code>PUBLIC_SUPABASE_URL</code> e <code>PUBLIC_SUPABASE_ANON_KEY</code> no <code>.env</code> para sincronizar.
              </>
            )}
          </span>
        </div>
        <span class="font-mono text-[10px] font-bold uppercase bg-black text-white px-2.5 py-1 rounded shrink-0">
          {tableMissing ? 'AÇÃO: EXECUTAR SCHEMA.SQL' : 'STATUS: PRONTO PARA PRODUÇÃO'}
        </span>
      </div>
    )}

    {manchetePrincipal ? (
      <>
        {/* =========================================================================
            1. BENTO GRID PRINCIPAL (grid-cols-1 md:grid-cols-3 lg:grid-cols-4)
            Cards principais com row-span-2 para hierarquia visual de alto padrão
        ========================================================================= */}
        <section class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5 mb-8" aria-labelledby="heading-bento">
          <h1 id="heading-bento" class="sr-only">Destaques Principais em Bento Grid</h1>
          
          <!-- Card 1: Manchete Hero Principal (ocupa 2 colunas e 2 linhas) -->
          <div class="col-span-1 md:col-span-2 lg:col-span-2 md:row-span-2">
            <NewsCard noticia={manchetePrincipal} variant="featured" priority={true} class="h-full" />
          </div>

          <!-- Card 2: Destaque Secundário Vertical (ocupa 1 coluna e 2 linhas) -->
          {destaqueSecundario && (
            <div class="col-span-1 md:col-span-1 lg:col-span-1 md:row-span-2">
              <NewsCard noticia={destaqueSecundario} variant="standard" class="h-full" />
            </div>
          )}

          <!-- Card 3 / Sidebar: Slot Publicitário Vertical Bento (min-h-[600px] para CLS) -->
          <div class="col-span-1 md:col-span-3 lg:col-span-1 md:row-span-1 lg:row-span-2 flex flex-col justify-between bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl p-4 shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all">
            <div class="flex items-center justify-between border-b-2 border-black dark:border-neutral-700 pb-2 mb-3">
              <span class="text-[10px] font-mono font-bold uppercase text-gray-500 tracking-wider">Espaço Patrocinado</span>
              <span class="text-[9px] font-mono font-bold bg-gray-100 dark:bg-neutral-800 text-gray-600 dark:text-gray-300 px-1.5 py-0.5 rounded border border-gray-300 dark:border-neutral-700">300x600</span>
            </div>
            
            <div class="flex-grow flex items-center justify-center">
              <AdBanner slotType="sidebar" customClass="!my-0" />
            </div>

            <div class="mt-3 pt-2.5 border-t border-gray-200 dark:border-neutral-800 text-center text-[10px] font-mono text-gray-400 uppercase">
              CLS RESILIENTE • ZERO SHIFT
            </div>
          </div>

          <!-- Linha 2 do Bento Grid: 3 Notícias de Apoio + Widget de Métricas -->
          {noticiasBentoGrid.map((item) => (
            <div class="col-span-1">
              <NewsCard noticia={item} variant="standard" class="h-full" />
            </div>
          ))}

          <!-- Card Widget: Métricas Core Web Vitals e Lighthouse -->
          <div class="col-span-1 flex flex-col justify-between bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl p-5 shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-black uppercase text-blue-600 tracking-wider bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded border border-blue-200 dark:border-blue-900">
                  Performance
                </span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              </div>
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-3xl sm:text-4xl font-black text-neutral-950 dark:text-white tracking-tight">98+</span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Score Máximo</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-neutral-300 leading-relaxed font-medium">
                Arquitetura SSR otimizada no Vercel Edge. Cumprimento total dos critérios Core Web Vitals do Google.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-200 dark:border-neutral-800 flex items-center justify-between text-[10px] font-mono font-bold text-gray-400 uppercase">
              <span>LCP &lt; 1.2s</span>
              <span>CLS = 0.00</span>
            </div>
          </div>
        </section>

        {/* =========================================================================
            2. BANNER HORIZONTAL BENTO (Entre seções — min-h-[90px] para CLS)
        ========================================================================= */}
        <section class="my-8 flex justify-center" aria-label="Espaço Publicitário Central">
          <div class="w-full max-w-[728px] bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl p-2 shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all">
            <AdBanner slotType="header" customClass="!my-0" />
          </div>
        </section>

        {/* =========================================================================
            3. SEGUNDO BLOCO BENTO (Feed em Tempo Real com Destaque row-span-2)
        ========================================================================= */}
        {noticiasFeed.length > 0 && (
          <section class="mb-10">
            <div class="flex items-center justify-between border-b-2 border-black dark:border-neutral-700 pb-2.5 mb-6">
              <h2 class="text-xl sm:text-2xl font-black uppercase italic tracking-tight text-neutral-950 dark:text-white">
                Últimas Atualizações
              </h2>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5 rounded">
                  FEED: EM TEMPO REAL
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5">
              {noticiasFeed.map((item, index) => (
                <div class={index === 0 ? "col-span-1 md:col-span-2 lg:col-span-2 md:row-span-2" : "col-span-1"}>
                  <NewsCard 
                    noticia={item} 
                    variant={index === 0 ? "featured" : "standard"} 
                    class="h-full" 
                  />
                </div>
              ))}
            </div>
          </section>
        )}

        {/* =========================================================================
            4. MAIS LIDAS DA SEMANA (Bento Grid Compacto)
        ========================================================================= */}
        {noticiasMaisLidas.length > 0 && (
          <section class="mb-12 bg-white dark:bg-neutral-900 border-2 border-black dark:border-neutral-700 rounded-xl p-5 sm:p-6 shadow-none hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all">
            <div class="flex items-center justify-between border-b-2 border-black dark:border-neutral-700 pb-3 mb-4">
              <h3 class="text-lg font-black uppercase italic tracking-tight text-neutral-950 dark:text-white">
                Mais Lidas da Semana
              </h3>
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600">
                Tendências em Alta
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {noticiasMaisLidas.map((item) => (
                <NewsCard noticia={item} variant="compact" />
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="text-center py-20 bg-white dark:bg-neutral-900 rounded-xl border-2 border-black dark:border-neutral-700 p-8">
        <h2 class="text-2xl font-black uppercase italic text-neutral-900 dark:text-white mb-2">
          Nenhuma notícia publicada no momento
        </h2>
        <p class="text-gray-500 max-w-md mx-auto text-sm">
          O pipeline de automação (Make / n8n) está configurado para alimentar a tabela <code>noticias</code> do Supabase automaticamente.
        </p>
      </div>
    )}

  </div>
</Layout>
